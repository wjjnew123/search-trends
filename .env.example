# search-trends 环境变量示例（复制为 .env；本地自备密钥）

# 搜索（Serper）：https://serper.dev/api-keys
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev

# Google Trends 后端（至少一个）
TRENDSMCP_API_KEY=
TRENDSMCP_BASE_URL=https://api.trendsmcp.ai
HASDATA_API_KEY=
HASDATA_BASE_URL=https://api.hasdata.com

# 默认趋势后端：trendsmcp | hasdata | local
DEFAULT_TRENDS_PROVIDER=trendsmcp

# 自建逆向（local）防封：最小请求间隔、超时
LOCAL_TRENDS_MIN_INTERVAL_MS=3000
LOCAL_TRENDS_TIMEOUT_MS=30000
LOCAL_TRENDS_COUNTRY=US
LOCAL_TRENDS_LANGUAGE=en-US

# HTTP 行为 / 缓存
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=2
CACHE_ENABLED=true
CACHE_TTL_MS=300000

# HTTP 传输（--http 时）
MCP_HTTP_HOST=127.0.0.1
PORT=3000
# MCP_HTTP_TOKEN=change-me

LOG_LEVEL=info
